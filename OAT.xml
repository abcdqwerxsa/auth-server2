<configuration>
    <oatconfig>

        <policylist>
            <policy name="projectPolicy">
                <policyitem type="compatibility" name="MulanPSL-2.0" path=".*"/>
                <policyitem type="license" name="MulanPSL-2.0" path=".*.go"/>
                <policyitem type="license" name="MulanPSL-2.0" path=".*.sh"/>
                <policyitem type="copyright" name="Huawei Technologies Co., Ltd." path=".*.go"/>
                <policyitem type="copyright" name="Huawei Technologies Co., Ltd." path=".*.sh"/>
                <policyitem type="filename" name="LICENSE" path=""/>
                <policyitem type="filetype" name="!binary" path=".*" filefilter="binaryFileTypeFilter"/>
            </policy>
        </policylist>

        <filefilterlist>
            <filefilter name="binaryFileTypeFilter">
                <filefilteritem type="filepath" name="/LICENSE"/>
            </filefilter>
        </filefilterlist>

        <licensematcherlist>
            <licensematcher name="MulanPSL-2.0" desc="Mulan Permissive Software License, Version 2">
                <licensetext name="is licensed under Mulan PSL v2"/>
            </licensematcher>
            <licensematcher name="MulanPSL-2.0" desc="Mulan Permissive Software License, Version 2">
                <licensetext name="
                    Mulan Permissive Software License，Version 2 (Mulan PSL v2)
                    January 2020 http://license.coscl.org.cn/MulanPSL2
                "/>
            </licensematcher>
            <licensematcher name="MulanPSL-2.0" desc="Mulan Permissive Software License, Version 2">
                <licensetext name="
                    木兰宽松许可证， 第2版
                    2020年1月 http://license.coscl.org.cn/MulanPSL2
                "/>
            </licensematcher>
        </licensematcherlist>

    </oatconfig>
</configuration>
